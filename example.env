DISCORD_TOKEN=
GUILD_ID=
CHANNEL_ID=
DB_PATH=

# Live scores channel (optional; leave blank to post no scores).
SCORES_CHANNEL_ID=
# ESPN team whose matches get live scores. Blank means Pitt (221). On a test
# server, set it to any team playing today to watch the scoreboard work.
SCORES_TEAM_ID=

# Per-sport channels. Listings post to the channel for their sport; the two
# basketball sports share one. Anything left blank falls back to
# DEFAULT_SPORT_CHANNEL_ID, and if that is blank too, to CHANNEL_ID.
FOOTBALL_CHANNEL_ID=
BASKETBALL_CHANNEL_ID=
VOLLEYBALL_CHANNEL_ID=
BASEBALL_CHANNEL_ID=
DEFAULT_SPORT_CHANNEL_ID=
